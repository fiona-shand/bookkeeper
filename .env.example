# Local SQLite (optional — defaults to file:./prisma/dev.db)
# DATABASE_URL="file:./prisma/dev.db"

# Production on Vercel — Turso (libSQL). Leave unset for local SQLite.
# TURSO_DATABASE_URL="libsql://bookkeeper-xxx.turso.io"
# TURSO_AUTH_TOKEN=""

# Clerk authentication — copy these from the Clerk dashboard API Keys page.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
