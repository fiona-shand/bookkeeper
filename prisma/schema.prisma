generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String

  // Where this reader's Goodreads shelf lives, and when it was last pulled.
  goodreadsProfileId String?
  goodreadsSyncedAt  DateTime?

  createdAt DateTime @default(now())

  books    Book[]
  sessions Session[]
}

model Session {
  // The SHA-256 of the cookie token, never the token itself: a leaked database
  // then can't be replayed as a login.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Book {
  id      String @id @default(cuid())

  // Nullable only for books that predate accounts; the first account created
  // claims them. Every query filters on it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  author  String
  // Drives spine width via the PPI formula in src/lib/spine.ts.
  pages   Int
  // Drives spine height: "hardcover" | "trade" | "massMarket".
  binding String
  genre   String
  // Hex, sampled from the cover art when the book is added.
  color   String
  year    Int?

  isbn           String?
  coverUrl       String?
  // Open Library work key, so the same book can't be added twice.
  openLibraryKey String?
  // Goodreads book id, so re-running an import updates rather than duplicates.
  goodreadsId    String?

  // "reading" | "read" | "want" — "reading" is what draws the bookmark.
  status     String    @default("read")
  rating     Int?
  review     String?
  reviewedAt DateTime?

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two readers may each shelve the same book; one reader may not shelve it twice.
  @@unique([userId, openLibraryKey])
  @@unique([userId, goodreadsId])
  @@index([userId, status])
}
